# ============================================================
# Complaint System — Environment Configuration
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# --- Application Environment ---
APP_ENV=development

# --- Database ---
DATABASE_URL=sqlite:///./complaint_system.db
# Production (Phase 2+):
# DATABASE_URL=postgresql://user:password@localhost:5432/complaint_system

# --- JWT Security ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Redis (Phase 2+) ---
REDIS_URL=redis://localhost:6379/0

# --- External AI Classification Service ---
AI_CLASSIFIER_ENDPOINT=https://api.external-categorization.local/classify
AI_CLASSIFIER_API_KEY=REPLACE_WITH_YOUR_API_KEY

# --- Community Verification ---
VERIFICATION_THRESHOLD=5

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_ISSUE_MAX=5

# --- Object Storage (Phase 4) ---
# Leave S3_BUCKET_NAME blank to use local disk storage (default for dev).
# Set all four values to switch to S3 or MinIO in production.
#
# AWS S3:
#   S3_BUCKET_NAME=my-complaint-system-uploads
#   S3_REGION=ap-south-1
#   S3_ENDPOINT_URL=           (leave blank for AWS)
#   AWS_ACCESS_KEY_ID=REPLACE_WITH_KEY
#   AWS_SECRET_ACCESS_KEY=REPLACE_WITH_SECRET
#
# MinIO (self-hosted):
#   S3_BUCKET_NAME=complaint-uploads
#   S3_REGION=us-east-1
#   S3_ENDPOINT_URL=http://localhost:9000
#   AWS_ACCESS_KEY_ID=minioadmin
#   AWS_SECRET_ACCESS_KEY=minioadmin
#
S3_BUCKET_NAME=
S3_REGION=ap-south-1
S3_ENDPOINT_URL=
S3_PRESIGNED_EXPIRY_SECONDS=3600
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
